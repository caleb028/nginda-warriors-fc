# ==============================================================================
# NGINDA WARRIORS FC — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANT SECURITY DIRECTIVE:
# Deploy Application A (apps/public-website) and Application B (apps/control-centre)
# as two separate Vercel projects with appropriately restricted credentials.
# Never expose SUPABASE_SERVICE_ROLE_KEY, ADMIN_JWT_SECRET, or DARAJA_CONSUMER_SECRET
# to client-side code (never prefix privileged secrets with NEXT_PUBLIC_).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC WEBSITE ENVIRONMENT (ngindawarriorsfc.co.ke)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://ngindawarriorsfc.co.ke
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional shared webhook secret for on-demand ISR cache revalidation from Admin
REVALIDATION_WEBHOOK_SECRET=replace-with-64-char-random-revalidation-secret

# ------------------------------------------------------------------------------
# 2. PRIVATE ADMIN CONTROL CENTRE ENVIRONMENT (manage.ngindawarriorsfc.co.ke)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_URL=https://manage.ngindawarriorsfc.co.ke
# Privileged server-only Supabase key (ONLY set in Control Centre & secure server APIs)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
# Secret key for signing HTTP-only administrative sessions
ADMIN_JWT_SECRET=replace-with-64-char-cryptographic-jwt-secret
# Optional Bootstrap Setup Token required during initial Super Admin claim in production
SUPER_ADMIN_SETUP_TOKEN=replace-with-one-time-owner-setup-token

# ------------------------------------------------------------------------------
# 3. SAFARICOM DARAJA M-PESA INTEGRATION (Server-Side Only)
# ------------------------------------------------------------------------------
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=your-safaricom-daraja-consumer-key
DARAJA_CONSUMER_SECRET=your-safaricom-daraja-consumer-secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=your-safaricom-lipa-na-mpesa-passkey
DARAJA_CALLBACK_URL=https://ngindawarriorsfc.co.ke/api/mpesa/callback
DARAJA_WEBHOOK_SECRET=replace-with-callback-verification-token

# ------------------------------------------------------------------------------
# 4. LOCAL SYNCHRONIZED STORAGE PATH (Used automatically when Supabase env is omitted)
# ------------------------------------------------------------------------------
NGINDA_SHARED_DB_PATH=
