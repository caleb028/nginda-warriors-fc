{
  "name": "nginda-warriors-fc-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Nginda Warriors FC — Official Public Website & Separate Private Admin Control Centre Monorepo",
  "workspaces": [
    "apps/public-website",
    "apps/control-centre",
    "packages/shared"
  ],
  "scripts": {
    "dev:public": "npm --workspace=@nginda-warriors/public-website run dev",
    "dev:admin": "npm --workspace=@nginda-warriors/control-centre run dev",
    "build:public": "npm --workspace=@nginda-warriors/public-website run build",
    "build:admin": "npm --workspace=@nginda-warriors/control-centre run build",
    "build": "npm run build:public && npm run build:admin",
    "test": "node --import ./scripts/set-test-env.js --import tsx --test tests/acceptance.test.ts",
    "reset:db": "node --import tsx scripts/reset-db.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.446.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
