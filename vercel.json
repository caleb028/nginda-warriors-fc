{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "public-website": {
      "root": "apps/public-website",
      "framework": "nextjs"
    },
    "control-centre": {
      "root": "apps/control-centre",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/admin/:path*",
      "destination": {
        "service": "control-centre"
      }
    },
    {
      "source": "/manage",
      "destination": {
        "service": "control-centre"
      }
    },
    {
      "source": "/manage/:path*",
      "destination": {
        "service": "control-centre"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "public-website"
      }
    }
  ]
}
