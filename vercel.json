{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "public-website": {
      "root": "apps/public-website",
      "framework": "nextjs"
    },
    "control-centre": {
      "root": "apps/control-centre",
      "framework": "nextjs"
    }
  },
  "redirects": [
    {
      "source": "/login",
      "destination": "/manage/login",
      "permanent": false
    },
    {
      "source": "/admin/login",
      "destination": "/manage/login",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/manage",
      "permanent": false
    },
    {
      "source": "/admin/(.*)",
      "destination": "/manage/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin/(.*)",
      "destination": {
        "service": "control-centre",
        "path": "/manage/api/admin/$1"
      }
    },
    {
      "source": "/manage",
      "destination": {
        "service": "control-centre"
      }
    },
    {
      "source": "/manage/(.*)",
      "destination": {
        "service": "control-centre"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "public-website"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "public-website"
      }
    }
  ]
}
